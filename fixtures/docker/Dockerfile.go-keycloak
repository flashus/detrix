# syntax=docker/dockerfile:1
# check=skip=InvalidDefaultArgInFrom
# Go Test App Docker Image for Keycloak E2E
# Same build as Dockerfile.go but with debian runtime for JWT token acquisition.
# The entrypoint script fetches a JWT from Keycloak before starting the app.

# ---- Build Stage ----
ARG GO_IMAGE
ARG RUNTIME_IMAGE
FROM ${GO_IMAGE} AS builder

WORKDIR /src

COPY clients/go /src/clients/go
COPY fixtures/go /src/fixtures/go

WORKDIR /src/fixtures/go/string_capture

RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 go build -gcflags="all=-N -l" -o /build/detrix_example_app .

RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 go install github.com/go-delve/delve/cmd/dlv@v1.27.0

# ---- Runtime Stage (debian — has curl for token acquisition) ----
FROM ${RUNTIME_IMAGE}

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/detrix_example_app /usr/local/bin/detrix_example_app
COPY --from=builder /go/bin/dlv /usr/local/bin/dlv

COPY fixtures/docker/keycloak/entrypoint-go.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
