# Rust Test App Docker Image
# Multi-stage: build fixture with debug symbols (musl), runtime with Alpine lldb
#
# Why Alpine instead of Debian + lldb-21:
#   - Debian's lldb-21 (from apt.llvm.org) weighs ~450 MB: libLLVM-21.so and
#     libclang-cpp21.so alone are ~300 MB; the full install is unavoidable.
#   - Alpine's lldb package is ~5-8x smaller (musl, stripped, no Python bindings).
#   - detrix-rs uses rustls-tls (pure-Rust TLS, no OpenSSL) → the fixture
#     compiles to a fully static musl binary with zero OS runtime deps.
#
# lldb version: Alpine 3.21 ships lldb-17.0.6.  The --connection listen://
# server mode (used by the Detrix Rust client to start lldb-dap) was introduced
# in LLVM 17, so this is the minimum viable version.
#
# Caching: shares /usr/local/cargo/registry and /usr/local/cargo/git cache
# mounts with Dockerfile.server (same rust:alpine builder image).

# ---- Build Stage ----
FROM rust:1.93-alpine3.21 AS builder

# build-base: gcc + musl-dev for C FFI transitive deps
RUN apk add --no-cache build-base

WORKDIR /src

# Override target dir (the fixture's .cargo/config.toml points to a local path)
ENV CARGO_TARGET_DIR=/build/target

# Copy the Rust client
COPY clients/rust /src/clients/rust

# Copy the fixture
COPY fixtures/rust /src/fixtures/rust

WORKDIR /src/fixtures/rust

# Debug build (with debug symbols, NOT --release) + client feature.
# rust:alpine targets musl by default → fully static binary.
# Binary must be extracted from the cache mount in the same RUN step.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/build/target \
    cargo build --features client \
    && cp /build/target/debug/detrix_example_app /src/fixtures/rust/detrix_example_app

# ---- Runtime Stage ----
FROM alpine:3.21

# lldb: provides lldb-dap + lldb-server for Detrix to attach to the process.
# Alpine 3.21 ships lldb 17.0.6 which supports `--connection listen://host:port`
# (TCP server mode introduced in LLVM 17).
# Both binaries land in /usr/bin/ (in PATH) — no symlinks needed.
RUN apk add --no-cache lldb

# Copy static musl binary from build stage
COPY --from=builder /src/fixtures/rust/detrix_example_app /usr/local/bin/detrix_example_app

CMD ["detrix_example_app"]
