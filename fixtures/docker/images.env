# Detrix base images.
#
# All Dockerfiles declare ARG x (no default) and use FROM ${x}.
# Compose files pass build.args from here (--env-file fixtures/docker/images.env),
# the Taskfile reads values via sh vars, and direct builds use fixtures/docker/build.sh.
# bump a version in ONE place here.

# Rust toolchain (bookworm-based; also used for musl static builds)
RUST_IMAGE=rust:1.94.1-bookworm

# Modern Go toolchain (bookworm-based)
GO_IMAGE=golang:1.26.5-bookworm

# Go < 1.24 classic hash map (hmap/bmap/overflow chains) — intentionally pinned
GO_CLASSIC_IMAGE=golang:1.23.12-bookworm

# Python runtime
PYTHON_IMAGE=python:3.12-slim

# Shared runtime base (Debian bookworm slim — lldb-21 requires apt/llvm.org)
RUNTIME_IMAGE=debian:bookworm-slim
