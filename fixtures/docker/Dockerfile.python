# Python Test App Docker Image
# Runs the trade_bot_forever.py fixture with Detrix client

FROM python:3.12-slim

WORKDIR /app

# Install debugpy
RUN pip install --no-cache-dir debugpy

# Copy and install the Detrix Python client
COPY clients/python /tmp/detrix-client
RUN pip install --no-cache-dir /tmp/detrix-client && rm -rf /tmp/detrix-client

# Copy the fixture app
COPY fixtures/python/trade_bot_forever.py /app/trade_bot_forever.py

# Default: run the trading bot (Detrix client enabled via env vars)
CMD ["python", "trade_bot_forever.py"]
