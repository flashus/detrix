# Detrix Server Docker Image
# Multi-stage build: Rust build + slim runtime

# ---- Build Stage ----
FROM rust:latest AS builder

WORKDIR /src

# Install protoc (needed by detrix-api build script for proto compilation)
RUN apt-get update && apt-get install -y --no-install-recommends protobuf-compiler && rm -rf /var/lib/apt/lists/*

# Override the repo's .cargo/config.toml which points to a local path
ENV CARGO_TARGET_DIR=/build/target

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY .cargo .cargo
COPY crates crates
COPY clients/rust clients/rust
COPY detrix.toml detrix.minimal.toml ./

# Build the server binary
RUN cargo build --release --bin detrix -p detrix-cli

# ---- Runtime Stage ----
FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create data directory
RUN mkdir -p /data/detrix

# Copy binary from build stage
COPY --from=builder /build/target/release/detrix /usr/local/bin/detrix

# Copy config
COPY docker/detrix.toml /data/detrix/detrix.toml

EXPOSE 8090 50061

HEALTHCHECK --interval=5s --timeout=3s --retries=10 \
    CMD curl -f http://localhost:8090/health || exit 1

CMD ["detrix", "serve", "--config", "/data/detrix/detrix.toml"]
